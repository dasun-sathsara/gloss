# Copy to your Gloss config directory, not into the checkout.
GOOGLE_CLOUD_PROJECT=your-project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\you\AppData\Roaming\Gloss\credentials\sa.json
VOICE=Kore
DECK_PARENT=Gloss
DECK_DEFAULT=General
# Optional GitHub owner/repo for completed-release updates.
GLOSS_RELEASE_REPO=


# Match AnkiConnect webBindPort; keep its bind address local.
ANKI_CONNECT_PORT=8765
