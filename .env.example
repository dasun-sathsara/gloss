# Copy to your Gloss config directory, not into the checkout.
GOOGLE_CLOUD_PROJECT=your-project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\you\AppData\Roaming\Gloss\credentials\sa.json
# Optional OpenAI-compatible text endpoint. When both are set, words come from
# TEXT_API_BASE and Google is only needed for audio.
# TEXT_API_BASE=https://example.modal.run/v1
# TEXT_API_KEY=sk-...
# Optional local audio through Underdog Woof. Point this at a downloaded copy of
# huggingface.co/ConwayResearch/Underdog-Woof. Non-commercial weights; not bundled.
# WOOF_MODEL_DIR=C:\Users\you\AppData\Roaming\Gloss\underdog-woof
# WOOF_VOICE=juno
VOICE=Kore
DECK_PARENT=Gloss
DECK_DEFAULT=General
# Optional GitHub owner/repo for completed-release updates.
GLOSS_RELEASE_REPO=


# Match AnkiConnect webBindPort; keep its bind address local.
ANKI_CONNECT_PORT=8765
